{
  "name": "kvdb-sdk",
  "version": "0.2.0",
  "description": "High-performance, multi-driver, extensible KV Database SDK for Node.js — unified data interface, JSON query, and an independent cache system.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compliance": "vitest run test/compliance",
    "test:compliance:all": "bash scripts/run-docker-compliance.sh",
    "test:e2e": "vitest run test/e2e",
    "example": "tsx",
    "examples": "tsx examples/run-all.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "better-sqlite3": "*",
    "ioredis": "*",
    "mongodb": "*",
    "mysql2": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "lru-cache": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^11.0.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.0.0",
    "mysql2": "^3.24.5",
    "pg": "^8.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "kv",
    "key-value",
    "database",
    "sqlite",
    "postgresql",
    "mongodb",
    "cache",
    "json-query",
    "typescript"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
